---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import getReadingTime from 'reading-time';
import WriteupLayout from '../../layouts/WriteupLayout.astro';

export async function getStaticPaths() {
  const writeups = await getCollection('writeups', ({ data }) => !data.draft);

  return writeups.map((writeup) => ({
    params: { slug: writeup.id },
    props: { writeup },
  }));
}

interface Props {
  writeup: CollectionEntry<'writeups'>;
}

const { writeup } = Astro.props;
const { Content, headings } = await render(writeup);
const reading = getReadingTime(writeup.body ?? '');
const readingMinutes = Math.max(1, Math.round(reading.minutes));
---

<WriteupLayout
  writeup={writeup}
  headings={headings}
  readingMinutes={readingMinutes}
>
  <Content />
</WriteupLayout>
