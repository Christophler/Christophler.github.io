---
import BaseLayout from '../layouts/BaseLayout.astro';
import AvailabilityBlock from '../components/AvailabilityBlock.astro';
import Timeline from '../components/Timeline.astro';
import CertList from '../components/CertList.astro';
import SkillsTags from '../components/SkillsTags.astro';
import { site } from '../data/site';
---

<BaseLayout
  title={`Experience · ${site.name}`}
  description="Roles, impact, and skills — backend and cloud engineering."
>
  <section class="page-header">
    <h1>Experience</h1>
    <p>
      Roles and projects with a focus on what was built, deployed, and improved.
    </p>
  </section>

  <AvailabilityBlock />
  <Timeline />
  <CertList />
  <SkillsTags />

  <section class="resume-cta" aria-labelledby="resume-cta-heading">
    <h2 id="resume-cta-heading">Resume</h2>
    <p>
      Prefer a PDF?
      <a href={site.resumePath} download>Download resume</a>
      ·
      <a href={`mailto:${site.email}`}>Email me</a>
    </p>
  </section>
</BaseLayout>
