---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CredibilityStrip from '../components/CredibilityStrip.astro';
import ExternalLink from '../components/ExternalLink.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import InternalLink from '../components/InternalLink.astro';
import Pillars from '../components/Pillars.astro';
import SkillsTags from '../components/SkillsTags.astro';
import { experience, formatExperiencePeriod } from '../data/experience';
import { site } from '../data/site';

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
});

const experienceSnapshot = experience.entries.slice(0, 2);

const writeupTeasers = (
  await getCollection('writeups', ({ data }) => !data.draft)
)
  .sort((a, b) => {
    const aDate = a.data.updated ?? a.data.date;
    const bDate = b.data.updated ?? b.data.date;
    return bDate.valueOf() - aDate.valueOf();
  })
  .slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <h1>{site.name}</h1>
    <p class="hero-role">{site.title}</p>
    <p class="hero-tagline">{site.tagline}</p>
    <p class="hero-cta">
      <InternalLink href="/projects">View projects</InternalLink>
      <span class="hero-cta-sep" aria-hidden="true">·</span>
      <a href={`mailto:${site.email}`}>Get in touch</a>
    </p>
  </section>

  <CredibilityStrip />
  <FeaturedProjects />
  <Pillars />

  <section class="landing-section" aria-labelledby="experience-snapshot-heading">
    <h2 id="experience-snapshot-heading">Experience</h2>
    <ul class="plain-list">
      {
        experienceSnapshot.map((entry) => (
          <li>
            <span class="plain-list-primary">{entry.role}</span>
            <span class="plain-list-muted">
              {entry.company} · {formatExperiencePeriod(entry.start, entry.end)}
            </span>
          </li>
        ))
      }
    </ul>
    <p class="section-link">
      <InternalLink href="/experience">Full experience & certifications</InternalLink>
    </p>
  </section>

  <section class="landing-section" aria-labelledby="writeups-teaser-heading">
    <h2 id="writeups-teaser-heading">Writeups</h2>
    <ul class="plain-list">
      {
        writeupTeasers.map((post) => {
          const sortDate = post.data.updated ?? post.data.date;
          return (
            <li>
              <InternalLink href={`/writeups/${post.id}`}>{post.data.title}</InternalLink>
              <span class="plain-list-muted">{dateFormatter.format(sortDate)}</span>
            </li>
          );
        })
      }
    </ul>
    <p class="section-link">
      <InternalLink href="/writeups">All writeups</InternalLink>
    </p>
  </section>

  <SkillsTags />

  <section class="contact-cta" aria-labelledby="contact-cta-heading">
    <h2 id="contact-cta-heading">Contact</h2>
    <p>
      Open to backend and cloud roles —
      <a href={`mailto:${site.email}`}>email</a>
      ·
      <ExternalLink href={site.linkedin}>LinkedIn</ExternalLink>
      ·
      <ExternalLink href={site.github}>GitHub</ExternalLink>
    </p>
  </section>
</BaseLayout>
