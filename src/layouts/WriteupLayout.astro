---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import InternalLink from '../components/InternalLink.astro';
import LastUpdated from '../components/LastUpdated.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import TableOfContents from '../components/TableOfContents.astro';
import BaseLayout from './BaseLayout.astro';
import { site } from '../data/site';

interface Props {
  writeup: CollectionEntry<'writeups'>;
  headings: MarkdownHeading[];
  readingMinutes: number;
}

const { writeup, headings, readingMinutes } = Astro.props;
const { title, description, tags, platform, difficulty, date, updated } =
  writeup.data;

const minutesLabel =
  readingMinutes <= 1 ? '1 min read' : `${readingMinutes} min read`;
---

<BaseLayout title={`${title} · ${site.name}`} description={description}>
  <ReadingProgress />
  <article class="writeup writeup--with-toc">
    <header class="writeup-header">
      <p class="writeup-back">
        <InternalLink href="/writeups">← Writeups</InternalLink>
      </p>
      <h1>{title}</h1>
      <p class="writeup-description">{description}</p>
      <div class="writeup-meta">
        <LastUpdated date={date} updated={updated} />
        <p class="writeup-meta-extra">
          <span>{minutesLabel}</span>
          {
            (platform || difficulty) && (
              <>
                <span aria-hidden="true"> · </span>
                {platform && <span>{platform}</span>}
                {platform && difficulty && <span aria-hidden="true"> · </span>}
                {difficulty && <span class="writeup-difficulty">{difficulty}</span>}
              </>
            )
          }
        </p>
      </div>
      {
        tags.length > 0 && (
          <ul class="writeup-card-tags" aria-label="Tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="writeup-layout">
      <TableOfContents headings={headings} />
      <div class="writeup-body prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
