---
import { ClientRouter, fade } from 'astro:transitions';
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import SeoHead from '../components/SeoHead.astro';
import { site } from '../data/site';
import { themeInitScript } from '../scripts/theme-init.ts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = site.name,
  description = site.tagline,
  image,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={themeInitScript} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <SeoHead title={title} description={description} image={image} noindex={noindex} />
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <Nav site={site} />
    <main id="main" transition:animate={fade({ duration: '0.25s' })}>
      <slot />
    </main>
    <Footer site={site} />
  </body>
</html>
