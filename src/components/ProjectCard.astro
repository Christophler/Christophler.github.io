---
import type { CollectionEntry } from 'astro:content';
import InternalLink from './InternalLink.astro';
import LastUpdated from './LastUpdated.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<article class="project-card">
  <h3>
    <InternalLink href={`/projects/${project.id}`}>{project.data.title}</InternalLink>
  </h3>
  <p>{project.data.description}</p>
  <ul class="project-card-stack" aria-label="Tech stack">
    {
      project.data.stack.map((tag) => (
        <li>{tag}</li>
      ))
    }
  </ul>
  <LastUpdated date={project.data.date} updated={project.data.updated} compact />
</article>
