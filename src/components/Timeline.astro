---
import {
  experience,
  formatExperiencePeriod,
  type ExperienceBullet,
} from '../data/experience';

function bulletLabel(bullet: ExperienceBullet): string | null {
  if (bullet.built) return `Built: ${bullet.built}`;
  if (bullet.deployed) return `Deployed: ${bullet.deployed}`;
  if (bullet.improved) return `Improved: ${bullet.improved}`;
  return null;
}
---

<section class="timeline" aria-labelledby="timeline-heading">
  <h2 id="timeline-heading">Experience</h2>
  <ol class="timeline-list">
    {
      experience.entries.map((entry) => (
        <li class="timeline-item">
          <header class="timeline-item-header">
            <h3>{entry.role}</h3>
            <p class="timeline-item-meta">
              {entry.company} · {entry.location} ·{' '}
              {formatExperiencePeriod(entry.start, entry.end)}
            </p>
          </header>
          <ul class="timeline-bullets">
            {entry.bullets.map((bullet) => {
              const label = bulletLabel(bullet);
              return label ? <li>{label}</li> : null;
            })}
          </ul>
        </li>
      ))
    }
  </ol>
</section>
