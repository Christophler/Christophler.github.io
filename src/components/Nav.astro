---
import InternalLink from './InternalLink.astro';
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/experience', label: 'Experience' },
  { href: '/projects', label: 'Projects' },
  { href: '/writeups', label: 'Writeups' },
];
---

<header class="site-header" transition:persist="site-header">
  <nav aria-label="Main">
    <ul class="site-nav-links">
      {
        navItems.map((item) => (
          <li>
            <InternalLink href={item.href}>{item.label}</InternalLink>
          </li>
        ))
      }
    </ul>
    <div class="site-header-actions">
      <InternalLink class="nav-resume" href="/resume">Resume</InternalLink>
      <ThemeToggle />
    </div>
  </nav>
</header>
