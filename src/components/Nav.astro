---
import type { SiteConfig } from '../data/site';
import InternalLink from './InternalLink.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/writeups', label: 'Writeups' },
  { href: '/experience', label: 'Experience' },
];
---

<header class="site-header" transition:persist="site-header">
  <nav aria-label="Main">
    <InternalLink class="site-logo" href="/">{site.shortName}</InternalLink>
    <ul class="site-nav-links">
      {
        navItems.map((item) => (
          <li>
            <InternalLink href={item.href}>{item.label}</InternalLink>
          </li>
        ))
      }
    </ul>
    <div class="site-header-actions">
      {site.showOpenToWorkPill && <span class="open-to-work-pill">Open to work</span>}
      <a class="nav-resume" href={site.resumePath} download data-astro-reload>Resume</a>
      <ThemeToggle />
    </div>
  </nav>
</header>
