---
import { certifications, formatCertDate } from '../data/certifications';
import ExternalLink from './ExternalLink.astro';
---

<section class="certifications" id="certifications" aria-labelledby="certifications-heading">
  <h2 id="certifications-heading">Certifications</h2>
  <ul class="cert-list">
    {
      certifications.map((cert) => (
        <li class="cert-item">
          <div class="cert-item-main">
            <h3>{cert.name}</h3>
            <p class="cert-item-meta">
              {cert.issuer} · {cert.examCode} · Issued {formatCertDate(cert.issueDate)}
              {cert.expiryDate
                ? ` · Expires ${formatCertDate(cert.expiryDate)}`
                : ' · No expiration'}
            </p>
          </div>
          <ExternalLink class="cert-verify" href={cert.verifyUrl}>
            Verify credential
          </ExternalLink>
        </li>
      ))
    }
  </ul>
</section>
